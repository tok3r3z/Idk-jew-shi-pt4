-- Raycasting Wall Check Helpers
local function isPartVisibleV1(targetPart, character)
    local rayOrigin = camera.CFrame.Position
    local rayDirection = targetPart.Position - rayOrigin
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = {}
    if player.Character then table.insert(filterList, player.Character) end
    if character then table.insert(filterList, character) end
    raycastParams.FilterDescendantsInstances = filterList

    return workspace:Raycast(rayOrigin, rayDirection, raycastParams) == nil
end

local function isPartVisibleV2(targetPart, character)
    local rayOrigin = camera.CFrame.Position
    local partsToCheck = {targetPart}
    if character:FindFirstChild("UpperTorso") and character.UpperTorso ~= targetPart then table.insert(partsToCheck, character.UpperTorso) end
    if character:FindFirstChild("Head") and character.Head ~= targetPart then table.insert(partsToCheck, character.Head) end

    for _, part in ipairs(partsToCheck) do
        local rayDirection = part.Position - rayOrigin
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local ignoreList = {player.Character, character}
        raycastParams.FilterDescendantsInstances = ignoreList

        local currentOrigin = rayOrigin
        local currentDirection = rayDirection
        local visible = true

        for _ = 1, 4 do
            local rayResult = workspace:Raycast(currentOrigin, currentDirection, raycastParams)
            if not rayResult then break end
            local hit = rayResult.Instance
            if hit and (not hit.CanCollide or hit.Transparency >= 0.7 or hit:IsA("Decal")) then
                table.insert(ignoreList, hit)
                raycastParams.FilterDescendantsInstances = ignoreList
                currentDirection = part.Position - rayResult.Position
                currentOrigin = rayResult.Position + (currentDirection.Unit * 0.01)
            else
                visible = false
                break
            end
        end
        if visible then return true end
    end
    return false
end

local function isPartVisibleV3(targetPart, character)
    local rayOrigin = camera.CFrame.Position
    local checkpoints = {targetPart.Position}
    if character:FindFirstChild("Head") then table.insert(checkpoints, character.Head.Position) end
    if character:FindFirstChild("HumanoidRootPart") then table.insert(checkpoints, character.HumanoidRootPart.Position) end

    for _, targetPos in ipairs(checkpoints) do
        local rayDirection = targetPos - rayOrigin
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local ignoreList = {player.Character, character}
        raycastParams.FilterDescendantsInstances = ignoreList

        local currentOrigin = rayOrigin
        local currentDirection = rayDirection
        local isFullyVisible = true

        for _ = 1, 5 do
            local rayResult = workspace:Raycast(currentOrigin, currentDirection, raycastParams)
            if not rayResult then break end

            local hitInstance = rayResult.Instance
            if hitInstance and (not hitInstance.CanCollide or hitInstance.Transparency >= 0.6 or hitInstance:IsA("Water") or hitInstance:IsA("Decal") or hitInstance:IsA("Texture")) then
                table.insert(ignoreList, hitInstance)
                raycastParams.FilterDescendantsInstances = ignoreList
                currentDirection = targetPos - rayResult.Position
                currentOrigin = rayResult.Position + (currentDirection.Unit * 0.05)
            else
                isFullyVisible = false
                break
            end
        end
        if isFullyVisible then return true end
    end
    return false
end

local function isPartVisible(targetPart, character)
    if Settings.WallCheckMethod == "WallCheck V3" then
        return isPartVisibleV3(targetPart, character)
    elseif Settings.WallCheckMethod == "WallCheck V2" then
        return isPartVisibleV2(targetPart, character)
    else
        return isPartVisibleV1(targetPart, character)
    end
end

-- Render Loop
local connection = RunService.RenderStepped:Connect(function(deltaTime)
    if not circle.Parent then
        connection:Disconnect()
        return
    end

    circle.Visible = Settings.ShowFOV

    -- Enforce Spoof Movement
    if Settings.SpoofMovement and player.Character then
        local myHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            myHumanoid.WalkSpeed = Settings.SpoofedWalkSpeed
            myHumanoid.JumpPower = Settings.SpoofedJumpPower
        end
    end

    -- js camlock v2 Logic Handler with Smooth Lerp
    if Settings.AngelCamlockEnabled then
        if not angelTargetPlayer or not angelTargetPlayer.Character or not angelTargetPlayer.Character:FindFirstChildOfClass("Humanoid") or angelTargetPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            local closest, dist = nil, math.huge
            local vp = camera.ViewportSize
            local mid = Vector2.new(vp.X/2, vp.Y/2)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local pos, on = camera:WorldToViewportPoint(hrp.Position)
                            if on then
                                local m = (Vector2.new(pos.X, pos.Y) - mid).Magnitude
                                if m < dist then
                                    dist = m
                                    closest = p
                                end
                            end
                        end
                    end
                end
            end
            angelTargetPlayer = closest
        end

        if angelTargetPlayer and angelTargetPlayer.Character then
            local prt = angelTargetPlayer.Character:FindFirstChild("HumanoidRootPart") or angelTargetPlayer.Character:FindFirstChild("Head")
            if prt then
                local targetCFrame = CFrame.new(camera.CFrame.Position, prt.Position)
                camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(deltaTime * 15, 0.1, 1))
            end
        end
    end

    -- ESP Rendering & General Character Updates
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local character = otherPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if character and humanoid and humanoid.Health > 0 and character.Parent and character:IsDescendantOf(workspace) then
                local isSameTeam = Settings.TeamCheck and player.Team and otherPlayer.Team and (otherPlayer.Team == player.Team)
                local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]
                
                if not isSameTeam and not isBlacklisted then
                    local targetCheckPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                    local isVisible = targetCheckPart and isPartVisible(targetCheckPart, character)
                    local activeColor = Settings.ESPVisibleCheck and (isVisible and Settings.ESPColorVisible or Settings.ESPColorInvisible) or Color3.fromRGB(255, 255, 255)

                    -- Bounding Box calculations
                    local cf, size = character:GetBoundingBox()
                    local screenPos, onScreen = camera:WorldToViewportPoint(cf.Position)
                    local scaleFactor = onScreen and (1 / (screenPos.Z * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000) or 0
                    local boxWidth = math.clamp(size.X * scaleFactor, 15, 300)
                    local boxHeight = math.clamp(size.Y * scaleFactor, 20, 500)
                    local boxX = screenPos.X - boxWidth / 2
                    local boxY = screenPos.Y - boxHeight / 2

                    -- ESP Render Logic
                    if Settings.ESPHighlights then
                        local highlight = activeHighlights[otherPlayer]
                        if not highlight or highlight.Parent ~= character then
                            if highlight then highlight:Destroy() end
                            highlight = Instance.new("Highlight")
                            highlight.Name = "JewScriptsHighlight"
                            highlight.Parent = character
                            activeHighlights[otherPlayer] = highlight
                        end
                        highlight.DepthMode = Enum.HighlightDepthMode[Settings.ChamsDepthMode] or Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillTransparency = Settings.ChamsFillTransparency
                        highlight.OutlineTransparency = Settings.ChamsOutlineTransparency
                        highlight.FillColor = activeColor
                        highlight.OutlineColor = activeColor
                    elseif activeHighlights[otherPlayer] then
                        activeHighlights[otherPlayer]:Destroy()
                        activeHighlights[otherPlayer] = nil
                    end

                    if Settings.ESPBoxes and onScreen then
                        local boxFrame = activeBoxes[otherPlayer]
                        local strokeObj
                        if not boxFrame then
                            boxFrame = Instance.new("Frame")
                            boxFrame.BackgroundTransparency = 1
                            boxFrame.BorderSizePixel = 0
                            strokeObj = Instance.new("UIStroke")
                            strokeObj.Thickness = 1.5
                            strokeObj.Parent = boxFrame
                            boxFrame.Parent = espScreenGui
                            activeBoxes[otherPlayer] = boxFrame
                        else
                            strokeObj = boxFrame:FindFirstChildOfClass("UIStroke")
                        end
                        
                        if strokeObj then strokeObj.Color = activeColor end
                        boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                        boxFrame.Position = UDim2.fromOffset(boxX, boxY)
                        boxFrame.Visible = true
                    elseif activeBoxes[otherPlayer] then
                        activeBoxes[otherPlayer].Visible = false
                    end

                    if Settings.ESPHealthBars and onScreen then
                        local hpData = activeHealthBars[otherPlayer]
                        if not hpData or not hpData.BG or not hpData.BG.Parent then
                            local bg = Instance.new("Frame")
                            bg.Name = "HP_BG"
                            bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                            bg.BorderSizePixel = 0
                            bg.Parent = espScreenGui

                            local fill = Instance.new("Frame")
                            fill.Name = "HP_Fill"
                            fill.BorderSizePixel = 0
                            fill.AnchorPoint = Vector2.new(0, 1)
                            fill.Position = UDim2.fromScale(0, 1)
                            fill.Parent = bg

                            hpData = {BG = bg, Fill = fill}
                            activeHealthBars[otherPlayer] = hpData
                        end

                        local curHp = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
                        local maxHp = math.max(humanoid.MaxHealth, 1)
                        local healthPercent = math.clamp(curHp / maxHp, 0, 1)

                        hpData.BG.Size = UDim2.fromOffset(4, boxHeight)
                        hpData.BG.Position = UDim2.fromOffset(boxX - 7, boxY)
                        hpData.Fill.Size = UDim2.fromScale(1, healthPercent)
                        hpData.Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                        hpData.BG.Visible = true
                    elseif activeHealthBars[otherPlayer] and activeHealthBars[otherPlayer].BG then
                        activeHealthBars[otherPlayer].BG.Visible = false
                    end

                    local headPart = character:FindFirstChild("Head")
                    if Settings.ESPHeadDots and headPart then
                        local headPos, headOnScreen = camera:WorldToViewportPoint(headPart.Position)
                        if headOnScreen then
                            local dotFrame = activeHeadDots[otherPlayer]
                            if not dotFrame then
                                dotFrame = Instance.new("Frame")
                                dotFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                                dotFrame.Size = UDim2.fromOffset(6, 6)
                                dotFrame.BorderSizePixel = 0
                                local uiCorner = Instance.new("UICorner")
                                uiCorner.CornerRadius = UDim.new(1, 0)
                                uiCorner.Parent = dotFrame
                                dotFrame.Parent = espScreenGui
                                activeHeadDots[otherPlayer] = dotFrame
                            end
                            dotFrame.Position = UDim2.fromOffset(headPos.X, headPos.Y)
                            dotFrame.BackgroundColor3 = activeColor
                            dotFrame.Visible = true
                        elseif activeHeadDots[otherPlayer] then
                            activeHeadDots[otherPlayer].Visible = false
                        end
                    elseif activeHeadDots[otherPlayer] then
                        activeHeadDots[otherPlayer].Visible = false
                    end

                    if (Settings.ESPNames or Settings.ESPDistance or Settings.ESPHealthText) and onScreen then
                        local textLabel = activeNames[otherPlayer]
                        if not textLabel then
                            textLabel = Instance.new("TextLabel")
                            textLabel.BackgroundTransparency = 1
                            textLabel.TextStrokeTransparency = 0
                            textLabel.TextSize = 13
                            textLabel.Font = Enum.Font.SourceSansBold
                            textLabel.Parent = espScreenGui
                            activeNames[otherPlayer] = textLabel
                        end

                        local labelText = ""
                        if Settings.ESPNames then labelText = otherPlayer.DisplayName end
                        if Settings.ESPHealthText then
                            local hpVal = math.floor(humanoid.Health)
                            labelText = labelText ~= "" and (labelText .. " [" .. hpVal .. " HP]") or ("[" .. hpVal .. " HP]")
                        end
                        if Settings.ESPDistance then
                            local dist = math.floor((camera.CFrame.Position - cf.Position).Magnitude)
                            labelText = labelText ~= "" and (labelText .. " [" .. dist .. "m]") or ("[" .. dist .. "m]")
                        end

                        textLabel.Text = labelText
                        textLabel.TextColor3 = activeColor
                        textLabel.Position = UDim2.fromOffset(screenPos.X, boxY - 15)
                        textLabel.Visible = true
                    elseif activeNames[otherPlayer] then
                        activeNames[otherPlayer].Visible = false
                    end

                    if Settings.ESPTracers and onScreen then
                        local tracerFrame = activeTracers[otherPlayer]
                        if not tracerFrame then
                            tracerFrame = Instance.new("Frame")
                            tracerFrame.BorderSizePixel = 0
                            tracerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                            tracerFrame.Parent = espScreenGui
                            activeTracers[otherPlayer] = tracerFrame
                        end

                        local screenBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                        local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (targetPos - screenBottom).Magnitude
                        local center = (screenBottom + targetPos) / 2
                        local angle = math.atan2(targetPos.Y - screenBottom.Y, targetPos.X - screenBottom.X)

                        tracerFrame.Size = UDim2.fromOffset(dist, 1)
                        tracerFrame.Position = UDim2.fromOffset(center.X, center.Y)
                        tracerFrame.Rotation = math.deg(angle)
                        tracerFrame.BackgroundColor3 = activeColor
                        tracerFrame.Visible = true
                    elseif activeTracers[otherPlayer] then
                        activeTracers[otherPlayer].Visible = false
                    end

                    if Settings.ESPSkeletons then
                        if not activeSkeletons[otherPlayer] then activeSkeletons[otherPlayer] = {} end
                        local pairsList = humanoid.RigType == Enum.HumanoidRigType.R15 and skeletonPairsR15 or skeletonPairsR6

                        for i, pair in ipairs(pairsList) do
                            local partA = character:FindFirstChild(pair[1])
                            local partB = character:FindFirstChild(pair[2])
                            local lineFrame = activeSkeletons[otherPlayer][i]
                            if not lineFrame then
                                lineFrame = Instance.new("Frame")
                                lineFrame.BorderSizePixel = 0
                                lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                                lineFrame.Parent = espScreenGui
                                activeSkeletons[otherPlayer][i] = lineFrame
                            end

                            if partA and partB then
                                local posA, onScreenA = camera:WorldToViewportPoint(partA.Position)
                                local posB, onScreenB = camera:WorldToViewportPoint(partB.Position)

                                if onScreenA or onScreenB then
                                    local p1 = Vector2.new(posA.X, posA.Y)
                                    local p2 = Vector2.new(posB.X, posB.Y)
                                    lineFrame.Size = UDim2.fromOffset((p2 - p1).Magnitude, 1.5)
                                    lineFrame.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
                                    lineFrame.Rotation = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
                                    lineFrame.BackgroundColor3 = activeColor
                                    lineFrame.Visible = true
                                else
                                    lineFrame.Visible = false
                                end
                            else
                                lineFrame.Visible = false
                            end
                        end
                    elseif activeSkeletons[otherPlayer] then
                        for _, lineFrame in pairs(activeSkeletons[otherPlayer]) do lineFrame:Destroy() end
                        activeSkeletons[otherPlayer] = nil
                    end

                else
                    cleanupPlayer(otherPlayer)
                end
            else
                cleanupPlayer(otherPlayer)
            end
        else
            cleanupPlayer(otherPlayer)
        end
    end

    -- Dynamic Aiming Calculation
    local aimAllowed = (Settings.PracticeEnabled and Settings.AimKeyActive) or Settings.CamlockActive
    currentAimTargetPlayer = nil

    if Settings.AngelCamlockEnabled and angelTargetPlayer then
        currentAimTargetPlayer = angelTargetPlayer
    elseif aimAllowed then
        local closestTarget = nil

        if Settings.CamlockActive then
            if camlockTargetPlayer then
                local char = camlockTargetPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local part = char and char:FindFirstChild(Settings.TargetPart)
                local isBlacklisted = BlacklistTable[camlockTargetPlayer.Name:lower()] or BlacklistTable[camlockTargetPlayer.DisplayName:lower()]
                
                if not (char and hum and hum.Health > 0 and part and not isBlacklisted) then
                    camlockTargetPlayer = nil
                else
                    closestTarget = part
                    currentAimTargetPlayer = camlockTargetPlayer
                end
            end

            if not camlockTargetPlayer then
                local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                local bestValue = Settings.FOV

                for _, otherPlayer in ipairs(Players:GetPlayers()) do
                    if otherPlayer ~= player and otherPlayer.Character then
                        local passesTeamCheck = not (Settings.TeamCheck and player.Team and otherPlayer.Team and otherPlayer.Team == player.Team)
                        local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]

                        if passesTeamCheck and not isBlacklisted then
                            local character = otherPlayer.Character
                            local humanoid = character:FindFirstChildOfClass("Humanoid")
                            local targetPart = character:FindFirstChild(Settings.TargetPart)

                            if humanoid and humanoid.Health > 0 and targetPart then
                                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                                if onScreen then
                                    local passesWallCheck = not Settings.WallCheck or isPartVisible(targetPart, character)

                                    if passesWallCheck then
                                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                        local crosshairDist = (screenPos2D - viewportCenter).Magnitude

                                        if crosshairDist <= bestValue then
                                            bestValue = crosshairDist
                                            camlockTargetPlayer = otherPlayer
                                            closestTarget = targetPart
                                            currentAimTargetPlayer = otherPlayer
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            local bestValue = Settings.TargetPriority == "Closest to Crosshair" and Settings.FOV or math.huge

            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character then
                    local passesTeamCheck = not (Settings.TeamCheck and player.Team and otherPlayer.Team and otherPlayer.Team == player.Team)
                    local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]

                    if passesTeamCheck and not isBlacklisted then
                        local character = otherPlayer.Character
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local targetPart = character:FindFirstChild(Settings.TargetPart)

                        if humanoid and humanoid.Health > 0 and targetPart then
                            local worldDist = (camera.CFrame.Position - targetPart.Position).Magnitude
                            if worldDist <= Settings.MaxDistance then
                                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                                if onScreen then
                                    local passesWallCheck = not Settings.WallCheck or isPartVisible(targetPart, character)

                                    if passesWallCheck then
                                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                        local crosshairDist = (screenPos2D - viewportCenter).Magnitude

                                        if crosshairDist <= Settings.FOV then
                                            if Settings.TargetPriority == "Closest to Crosshair" then
                                                if crosshairDist < bestValue then
                                                    bestValue = crosshairDist
                                                    closestTarget = targetPart
                                                    currentAimTargetPlayer = otherPlayer
                                                end
                                            elseif Settings.TargetPriority == "Closest Distance" then
                                                if worldDist < bestValue then
                                                    bestValue = worldDist
                                                    closestTarget = targetPart
                                                    currentAimTargetPlayer = otherPlayer
                                                end
                                            elseif Settings.TargetPriority == "Lowest Health" then
                                                if humanoid.Health < bestValue then
                                                    bestValue = humanoid.Health
                                                    closestTarget = targetPart
                                                    currentAimTargetPlayer = otherPlayer
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            local predictedPos = closestTarget.Position
            local rootPart = closestTarget.Parent:FindFirstChild("HumanoidRootPart")
            if rootPart then
                predictedPos = predictedPos + (rootPart.AssemblyLinearVelocity * Settings.Prediction)
            end

            if Settings.AimMethod == "Aim V1" then
                local targetCFrame = CFrame.new(camera.CFrame.Position, predictedPos)
                if Settings.Smoothness <= 0 then
                    camera.CFrame = targetCFrame
                else
                    local smoothnessAlpha = math.clamp(1 / Settings.Smoothness, 0.01, 1)
                    camera.CFrame = camera.CFrame:Lerp(targetCFrame, smoothnessAlpha)
                end
            elseif Settings.AimMethod == "Aim V2" then
                local lookVector = (predictedPos - camera.CFrame.Position).Unit
                local currentLook = camera.CFrame.LookVector
                
                if Settings.Smoothness <= 0 then
                    camera.CFrame = CFrame.new(camera.CFrame.Position, camera.CFrame.Position + lookVector)
                else
                    local alpha = math.clamp(1 / Settings.Smoothness, 0.01, 1)
                    local blendedLook = currentLook:Lerp(lookVector, alpha)
                    camera.CFrame = CFrame.new(camera.CFrame.Position, camera.CFrame.Position + blendedLook)
                end
            elseif Settings.AimMethod == "Aim V3" then
                local currentCFrame = camera.CFrame
                local targetCFrame = CFrame.new(currentCFrame.Position, predictedPos)
                
                if Settings.Smoothness <= 0 then
                    camera.CFrame = targetCFrame
                else
                    local factor = math.clamp(deltaTime * (25 / math.max(Settings.Smoothness, 1)), 0.01, 1)
                    local expAlpha = 1 - math.exp(-factor * 8)
                    camera.CFrame = currentCFrame:Lerp(targetCFrame, expAlpha)
                end
            end
        end
    end

    -- Hitmarker Tracker ONLY for Currently Locked Target
    if currentAimTargetPlayer and currentAimTargetPlayer.Character then
        local hum = currentAimTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local currentHp = hum.Health
            local lastHp = targetHealthMemory[currentAimTargetPlayer]

            if lastHp and currentHp < lastHp then
                local dmg = lastHp - currentHp
                playHitMarker(currentAimTargetPlayer, dmg)
            end
            targetHealthMemory[currentAimTargetPlayer] = currentHp
        end
    end
end)
