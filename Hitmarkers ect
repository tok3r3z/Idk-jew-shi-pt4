-- Dynamic Hitmarker Audio Trigger with Spam Debounce
local function playHitMarker(targetPlayer, damageDealt)
    if not Settings.HitMarkerEnabled then return end

    local now = tick()
    if now - lastHitmarkerTime < 0.15 then return end -- Debounce spam check
    lastHitmarkerTime = now

    pcall(function()
        local sound = Instance.new("Sound")
        sound.SoundId = Settings.HitMarkerSoundID
        sound.Volume = Settings.HitMarkerVolume
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)

    if Settings.HitMarkerNotifications and targetPlayer then
        local dmgText = damageDealt and (" (-" .. math.floor(damageDealt) .. " HP)") or ""
        showSmallNotification("Hit: " .. targetPlayer.DisplayName .. dmgText)
    end
end

