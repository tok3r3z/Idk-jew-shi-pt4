local fadeThread = nil
local function showSmallNotification(text)
    hitTextLabel.Text = text
    hitTextLabel.Visible = true
    hitTextLabel.TextTransparency = 0
    hitTextLabel.TextStrokeTransparency = 0

    if fadeThread then task.cancel(fadeThread) end
    fadeThread = task.delay(1.2, function()
        for i = 1, 10 do
            hitTextLabel.TextTransparency = i / 10
            hitTextLabel.TextStrokeTransparency = i / 10
            task.wait(0.03)
        end
        hitTextLabel.Visible = false
    end)
end

local function cleanupPlayer(p)
    if activeHighlights[p] then activeHighlights[p]:Destroy(); activeHighlights[p] = nil end
    if activeBoxes[p] then activeBoxes[p]:Destroy(); activeBoxes[p] = nil end
    if activeNames[p] then activeNames[p]:Destroy(); activeNames[p] = nil end
    if activeTracers[p] then activeTracers[p]:Destroy(); activeTracers[p] = nil end
    if activeHeadDots[p] then activeHeadDots[p]:Destroy(); activeHeadDots[p] = nil end
    if activeHealthBars[p] then
        if activeHealthBars[p].BG then activeHealthBars[p].BG:Destroy() end
        activeHealthBars[p] = nil
    end
    if activeSkeletons[p] then
        for _, lineFrame in pairs(activeSkeletons[p]) do lineFrame:Destroy() end
        activeSkeletons[p] = nil
    end
    if camlockTargetPlayer == p then camlockTargetPlayer = nil end
    if angelTargetPlayer == p then angelTargetPlayer = nil end
    if currentAimTargetPlayer == p then currentAimTargetPlayer = nil end
    targetHealthMemory[p] = nil
end

