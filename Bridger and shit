-- Render Loop (Restored Full ESP Suite & Optimized for iPhone 16e Performance)
local renderCounter = 0
local connection = RunService.RenderStepped:Connect(function(deltaTime)
    if not circle.Parent then
        connection:Disconnect()
        return
    end

    circle.Visible = Settings.ShowFOV

    -- Enforce Spoof Movement
    if Settings.SpoofMovement and player.Character then
        local myHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            myHumanoid.WalkSpeed = Settings.SpoofedWalkSpeed
            myHumanoid.JumpPower = Settings.SpoofedJumpPower
        end
    end

    -- Noclip Enforcer
    if Settings.Noclip and player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- js camlock v2 Logic Handler with Smooth Lerp
    if Settings.AngelCamlockEnabled then
        if not angelTargetPlayer or not angelTargetPlayer.Character or not angelTargetPlayer.Character:FindFirstChildOfClass("Humanoid") or angelTargetPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            local closest, dist = nil, math.huge
            local vp = camera.ViewportSize
            local mid = Vector2.new(vp.X/2, vp.Y/2)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and p.Character then
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local pos, on = camera:WorldToViewportPoint(hrp.Position)
                            if on then
                                local m = (Vector2.new(pos.X, pos.Y) - mid).Magnitude
                                if m < dist then
                                    dist = m
                                    closest = p
                                end
                            end
                        end
                    end
                end
            end
            angelTargetPlayer = closest
        end

        if angelTargetPlayer and angelTargetPlayer.Character then
            local prt = angelTargetPlayer.Character:FindFirstChild("HumanoidRootPart") or angelTargetPlayer.Character:FindFirstChild("Head")
            if prt then
                local targetCFrame = CFrame.new(camera.CFrame.Position, prt.Position)
                camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(deltaTime * 15, 0.1, 1))
            end
        end
    end

    -- Full ESP Suite Rendering Loop
    renderCounter = renderCounter + 1
    if renderCounter % 2 == 0 then
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                local character = otherPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")

                if character and humanoid and humanoid.Health > 0 and character.Parent and character:IsDescendantOf(workspace) then
                    local isSameTeam = Settings.TeamCheck and player.Team and otherPlayer.Team and (otherPlayer.Team == player.Team)
                    local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]
                    
                    if not isSameTeam and not isBlacklisted then
                        local targetCheckPart = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
                        local isVisible = targetCheckPart and isPartVisible(targetCheckPart, character)
                        local activeColor = Settings.ESPVisibleCheck and (isVisible and Settings.ESPColorVisible or Settings.ESPColorInvisible) or Color3.fromRGB(255, 255, 255)

                        local cf, size = character:GetBoundingBox()
                        local screenPos, onScreen = camera:WorldToViewportPoint(cf.Position)
                        local scaleFactor = onScreen and (1 / (screenPos.Z * math.tan(math.rad(camera.FieldOfView / 2)) * 2) * 1000) or 0
                        local boxWidth = math.clamp(size.X * scaleFactor, 15, 300)
                        local boxHeight = math.clamp(size.Y * scaleFactor, 20, 500)
                        local boxX = screenPos.X - boxWidth / 2
                        local boxY = screenPos.Y - boxHeight / 2

                        -- 1. Charms / Highlights
                        if Settings.ESPHighlights then
                            local highlight = activeHighlights[otherPlayer]
                            if not highlight or highlight.Parent ~= character then
                                if highlight then highlight:Destroy() end
                                highlight = Instance.new("Highlight")
                                highlight.Name = "JewScriptsHighlight"
                                highlight.Parent = character
                                activeHighlights[otherPlayer] = highlight
                            end
                            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            highlight.FillTransparency = Settings.ChamsFillTransparency
                            highlight.OutlineTransparency = Settings.ChamsOutlineTransparency
                            highlight.FillColor = activeColor
                            highlight.OutlineColor = activeColor
                        elseif activeHighlights[otherPlayer] then
                            activeHighlights[otherPlayer]:Destroy()
                            activeHighlights[otherPlayer] = nil
                        end

                        -- 2. ESP Boxes
                        if Settings.ESPBoxes and onScreen then
                            local boxFrame = activeBoxes[otherPlayer]
                            local strokeObj
                            if not boxFrame then
                                boxFrame = Instance.new("Frame")
                                boxFrame.BackgroundTransparency = 1
                                boxFrame.BorderSizePixel = 0
                                strokeObj = Instance.new("UIStroke")
                                strokeObj.Thickness = 1.5
                                strokeObj.Parent = boxFrame
                                boxFrame.Parent = espScreenGui
                                activeBoxes[otherPlayer] = boxFrame
                            else
                                strokeObj = boxFrame:FindFirstChildOfClass("UIStroke")
                            end
                            if strokeObj then strokeObj.Color = activeColor end
                            boxFrame.Size = UDim2.fromOffset(boxWidth, boxHeight)
                            boxFrame.Position = UDim2.fromOffset(boxX, boxY)
                            boxFrame.Visible = true
                        elseif activeBoxes[otherPlayer] then
                            activeBoxes[otherPlayer].Visible = false
                        end

                        -- 3. Health Bars
