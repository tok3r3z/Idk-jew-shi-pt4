                                tracerFrame = Instance.new("Frame")
                                tracerFrame.BorderSizePixel = 0
                                tracerFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                                tracerFrame.Parent = espScreenGui
                                activeTracers[otherPlayer] = tracerFrame
                            end

                            local screenBottom = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                            local dist = (targetPos - screenBottom).Magnitude
                            local center = (screenBottom + targetPos) / 2
                            local angle = math.atan2(targetPos.Y - screenBottom.Y, targetPos.X - screenBottom.X)

                            tracerFrame.Size = UDim2.fromOffset(dist, 1)
                            tracerFrame.Position = UDim2.fromOffset(center.X, center.Y)
                            tracerFrame.Rotation = math.deg(angle)
                            tracerFrame.BackgroundColor3 = activeColor
                            tracerFrame.Visible = true
                        elseif activeTracers[otherPlayer] then
                            activeTracers[otherPlayer].Visible = false
                        end

                        -- 7. Skeletons
                        if Settings.ESPSkeletons then
                            if not activeSkeletons[otherPlayer] then activeSkeletons[otherPlayer] = {} end
                            local pairsList = humanoid.RigType == Enum.HumanoidRigType.R15 and skeletonPairsR15 or skeletonPairsR6

                            for i, pair in ipairs(pairsList) do
                                local partA = character:FindFirstChild(pair[1])
                                local partB = character:FindFirstChild(pair[2])
                                local lineFrame = activeSkeletons[otherPlayer][i]
                                if not lineFrame then
                                    lineFrame = Instance.new("Frame")
                                    lineFrame.BorderSizePixel = 0
                                    lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
                                    lineFrame.Parent = espScreenGui
                                    activeSkeletons[otherPlayer][i] = lineFrame
                                end

                                if partA and partB then
                                    local posA, onScreenA = camera:WorldToViewportPoint(partA.Position)
                                    local posB, onScreenB = camera:WorldToViewportPoint(partB.Position)

                                    if onScreenA or onScreenB then
                                        local p1 = Vector2.new(posA.X, posA.Y)
                                        local p2 = Vector2.new(posB.X, posB.Y)
                                        lineFrame.Size = UDim2.fromOffset((p2 - p1).Magnitude, 1.5)
                                        lineFrame.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
                                        lineFrame.Rotation = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X))
                                        lineFrame.BackgroundColor3 = activeColor
                                        lineFrame.Visible = true
                                    else
                                        lineFrame.Visible = false
                                    end
                                else
                                    lineFrame.Visible = false
                                end
                            end
                        elseif activeSkeletons[otherPlayer] then
                            for _, lineFrame in pairs(activeSkeletons[otherPlayer]) do lineFrame:Destroy() end
                            activeSkeletons[otherPlayer] = nil
                        end

                    else
                        cleanupPlayer(otherPlayer)
                    end
                else
                    cleanupPlayer(otherPlayer)
                end
            else
                cleanupPlayer(otherPlayer)
            end
        end
    end

    -- Dynamic Aiming Calculation
    local aimAllowed = (Settings.PracticeEnabled and Settings.AimKeyActive) or Settings.CamlockActive
    currentAimTargetPlayer = nil

    if Settings.AngelCamlockEnabled and angelTargetPlayer then
        currentAimTargetPlayer = angelTargetPlayer
    elseif aimAllowed then
        local closestTarget = nil

        if Settings.CamlockActive then
            if camlockTargetPlayer then
                local char = camlockTargetPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local part = char and char:FindFirstChild(Settings.TargetPart)
                local isBlacklisted = BlacklistTable[camlockTargetPlayer.Name:lower()] or BlacklistTable[camlockTargetPlayer.DisplayName:lower()]
                
                if not (char and hum and hum.Health > 0 and part and not isBlacklisted) then
                    camlockTargetPlayer = nil
                else
                    closestTarget = part
                    currentAimTargetPlayer = camlockTargetPlayer
                end
            end

            if not camlockTargetPlayer then
                local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                local bestValue = Settings.FOV

                for _, otherPlayer in ipairs(Players:GetPlayers()) do
                    if otherPlayer ~= player and otherPlayer.Character then
                        local passesTeamCheck = not (Settings.TeamCheck and player.Team and otherPlayer.Team and otherPlayer.Team == player.Team)
                        local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]

                        if passesTeamCheck and not isBlacklisted then
                            local character = otherPlayer.Character
                            local humanoid = character:FindFirstChildOfClass("Humanoid")
                            local targetPart = character:FindFirstChild(Settings.TargetPart)

                            if humanoid and humanoid.Health > 0 and targetPart and isPartVisible(targetPart, character) then
                                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                                if onScreen then
                                    local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                    local crosshairDist = (screenPos2D - viewportCenter).Magnitude

                                    if crosshairDist <= bestValue then
                                        bestValue = crosshairDist
                                        camlockTargetPlayer = otherPlayer
                                        closestTarget = targetPart
                                        currentAimTargetPlayer = otherPlayer
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            local bestValue = Settings.TargetPriority == "Closest to Crosshair" and Settings.FOV or math.huge

            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character then
                    local passesTeamCheck = not (Settings.TeamCheck and player.Team and otherPlayer.Team and otherPlayer.Team == player.Team)
                    local isBlacklisted = BlacklistTable[otherPlayer.Name:lower()] or BlacklistTable[otherPlayer.DisplayName:lower()]

                    if passesTeamCheck and not isBlacklisted then
                        local character = otherPlayer.Character
                        local humanoid = character:FindFirstChildOfClass("Humanoid")
                        local targetPart = character:FindFirstChild(Settings.TargetPart)

                        if humanoid and humanoid.Health > 0 and targetPart and isPartVisible(targetPart, character) then
                            local worldDist = (camera.CFrame.Position - targetPart.Position).Magnitude
                            if worldDist <= Settings.MaxDistance then
                                local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                                if onScreen then
                                    local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                                    local crosshairDist = (screenPos2D - viewportCenter).Magnitude

                                    if crosshairDist <= Settings.FOV then
                                        if Settings.TargetPriority == "Closest to Crosshair" then
                                            if crosshairDist < bestValue then
                                                bestValue = crosshairDist
                                                closestTarget = targetPart
                                                currentAimTargetPlayer = otherPlayer
                                            end
                                        elseif Settings.TargetPriority == "Closest Distance" then
                                            if worldDist < bestValue then
                                                bestValue = worldDist
                                                closestTarget = targetPart
                                                currentAimTargetPlayer = otherPlayer
                                            end
                                        elseif Settings.TargetPriority == "Lowest Health" then
                                            if humanoid.Health < bestValue then
                                                bestValue = humanoid.Health
                                                closestTarget = targetPart
                                                currentAimTargetPlayer = otherPlayer
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            local predictedPos = closestTarget.Position
            local rootPart = closestTarget.Parent:FindFirstChild("HumanoidRootPart")
            if rootPart then
                predictedPos = predictedPos + (rootPart.AssemblyLinearVelocity * Settings.Prediction)
            end

            local targetCFrame = CFrame.new(camera.CFrame.Position, predictedPos)
            if Settings.Smoothness <= 0 then
                camera.CFrame = targetCFrame
            else
                local smoothnessAlpha = math.clamp(1 / Settings.Smoothness, 0.01, 1)
                camera.CFrame = camera.CFrame:Lerp(targetCFrame, smoothnessAlpha)
            end
        end
    end

    -- Hitmarker Tracker ONLY for Currently Locked Target
    if currentAimTargetPlayer and currentAimTargetPlayer.Character then
        local hum = currentAimTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local currentHp = hum.Health
            local lastHp = targetHealthMemory[currentAimTargetPlayer]

            if lastHp and currentHp < lastHp then
                local dmg = lastHp - currentHp
                playHitMarker(currentAimTargetPlayer, dmg)
            end
            targetHealthMemory[currentAimTargetPlayer] = currentHp
        end
    end
end)
