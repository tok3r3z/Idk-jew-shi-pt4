                            hpData.Fill.BackgroundColor3 = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                            hpData.BG.Visible = true
                        elseif activeHealthBars[otherPlayer] and activeHealthBars[otherPlayer].BG then
                            activeHealthBars[otherPlayer].BG.Visible = false
                        end

                        -- 4. Head Dots
                        local headPart = character:FindFirstChild("Head")
                        if Settings.ESPHeadDots and headPart then
