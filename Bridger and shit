                            end

                            textLabel.Text = labelText
                            textLabel.TextColor3 = activeColor
                            textLabel.Position = UDim2.fromOffset(screenPos.X, boxY - 15)
                            textLabel.Visible = true
                        elseif activeNames[otherPlayer] then
                            activeNames[otherPlayer].Visible = false
                        end

                        -- 6. Tracers
                        if Settings.ESPTracers and onScreen then
                            local tracerFrame = activeTracers[otherPlayer]
