-- Comprehensive Wall Check Methods (V1, V2, V3)
local function isPartVisible(targetPart, character)
    if not Settings.WallCheck then return true end
    local method = Settings.WallCheckMethod
    local rayOrigin = camera.CFrame.Position
    local rayDirection = targetPart.Position - rayOrigin

    if method == "WallCheck V1" then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {player.Character, character}
        return workspace:Raycast(rayOrigin, rayDirection, raycastParams) == nil
    elseif method == "WallCheck V2" then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Include
        raycastParams.FilterDescendantsInstances = {workspace}
        local result = workspace:Raycast(rayOrigin, rayDirection)
        return result == nil or result.Instance:IsDescendantOf(character)
    elseif method == "WallCheck V3" then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {player.Character, character}
        local hit1 = workspace:Raycast(rayOrigin, rayDirection, raycastParams) == nil
        local hit2 = workspace:Raycast(camera.CFrame.Position, (character:GetPivot().Position - camera.CFrame.Position), raycastParams) == nil
        return hit1 and hit2
    end
    return true
end

