                                    dotFrame.BorderSizePixel = 0
                                    local uiCorner = Instance.new("UICorner")
                                    uiCorner.CornerRadius = UDim.new(1, 0)
                                    uiCorner.Parent = dotFrame
                                    dotFrame.Parent = espScreenGui
                                    activeHeadDots[otherPlayer] = dotFrame
                                end
                                dotFrame.Position = UDim2.fromOffset(headPos.X, headPos.Y)
                                dotFrame.BackgroundColor3 = activeColor
                                dotFrame.Visible = true
                            elseif activeHeadDots[otherPlayer] then
                                activeHeadDots[otherPlayer].Visible = false
                            end
                        elseif activeHeadDots[otherPlayer] then
                            activeHeadDots[otherPlayer].Visible = false
                        end

                        -- 5. Names & Distance & Health Text
                        if (Settings.ESPNames or Settings.ESPDistance or Settings.ESPHealthText) and onScreen then
                            local textLabel = activeNames[otherPlayer]
