-- Robust Silent Aim Target Selector (Scans inside FOV)
local function getSilentAimTarget()
    local bestTarget = nil
    local bestDist = Settings.FOV
    local viewportCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local passesTeamCheck = not (Settings.TeamCheck and player.Team and p.Team and p.Team == player.Team)
            local isBlacklisted = BlacklistTable[p.Name:lower()] or BlacklistTable[p.DisplayName:lower()]

            if passesTeamCheck and not isBlacklisted then
                local character = p.Character
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local targetPart = character:FindFirstChild(Settings.SilentAimPart)

                if humanoid and humanoid.Health > 0 and targetPart then
                    local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen and isPartVisible(targetPart, character) then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if dist <= bestDist then
                            bestDist = dist
                            bestTarget = targetPart
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- Advanced Metatable Hook for Silent Aim (Intercepts workspace Raycasts & Mouse Vectoring)
pcall(function()
    if not getrawmetatable then return end
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if Settings.SilentAimEnabled and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList") then
            local targetPart = getSilentAimTarget()
            if targetPart and self == workspace then
                if method == "Raycast" then
                    local origin = args[1]
                    local direction = (targetPart.Position - origin).Unit * (targetPart.Position - origin).Magnitude
                    args[2] = direction
                    return workspace:Raycast(origin, direction, args[3])
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
    setreadonly(mt, true)
end)

