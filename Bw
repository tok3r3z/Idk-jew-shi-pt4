local Maid = {}
Maid.__index = Maid
function Maid.new()
	return setmetatable({ Tasks = {} }, Maid)
end
function Maid:Give(taskItem)
	self.Tasks[#self.Tasks + 1] = taskItem
	return taskItem
end
function Maid:Cleanup()
	for index = #self.Tasks, 1, -1 do
		local taskItem = self.Tasks[index]
		self.Tasks[index] = nil
		if typeof(taskItem) == "RBXScriptConnection" then
			pcall(function() taskItem:Disconnect() end)
		elseif typeof(taskItem) == "Instance" then
			pcall(function() taskItem:Destroy() end)
		elseif typeof(taskItem) == "function" then
			pcall(taskItem)
		elseif typeof(taskItem) == "table" and typeof(taskItem.Destroy) == "function" then
			pcall(function() taskItem:Destroy() end)
		end
	end
end
Maid.Destroy = Maid.Cleanup

local Input = {}
Input.__index = Input
function Input.new(services)
	return setmetatable({
		Services = services,
		Actions = {},
		Bindings = {},
		Observers = {},
		Destroyed = false,
	}, Input)
end
function Input:Register(name, callback)
	assert(not self.Destroyed and type(name) == "string" and name ~= "", "invalid input action")
	self.Actions[name] = { Callback = callback }
	return function() self.Actions[name] = nil end
end
function Input:Invoke(name, ...)
	local action = not self.Destroyed and self.Actions[name]
	if not action then return false, "action unavailable" end
	return pcall(action.Callback, ...)
end

