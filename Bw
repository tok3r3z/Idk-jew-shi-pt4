    layout.Padding = UDim.new(0, 6)
    layout.Parent = panel
    tabFrames[name] = panel

    if name == "Fish" then
        addSection(panel, "[ AUTO FISHING ]")
        addToggle(panel, "Auto Cast & Reel", false, function(v)
            if v and InputHandlerClient and InputHandlerClient.FireVirtualInput then
                pcall(function() InputHandlerClient:FireVirtualInput("PrimaryInput") end)
            end
        end)
        addToggle(panel, "Auto Pass Minigames", true, function(v) end)
        addButton(panel, "Instant Catch", "Execute", function()
            if InputHandlerClient and InputHandlerClient.FireVirtualInput then
                pcall(function() InputHandlerClient:FireVirtualInput("BringBack") end)
            end
        end)
    elseif name == "Travel" then
        addSection(panel, "[ HORSE & MOVEMENT ]")
        addButton(panel, "Summon Horse", "Summon", function()
            pcall(function()
                if InputHandlerClient and InputHandlerClient.FireVirtualInput then
                    InputHandlerClient:FireVirtualInput("SummonHorse")
                end
            end)
        end)
        addButton(panel, "Save Current Position", "Save", function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                getgenv().SavedWaypoint = char.HumanoidRootPart.CFrame
            end
        end)
        addButton(panel, "Teleport to Saved Point", "Teleport", function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and getgenv().SavedWaypoint then
                char.HumanoidRootPart.CFrame = getgenv().SavedWaypoint
            end
        end)
    elseif name == "NPCs" then
        addSection(panel, "[ NPC & GYRO UTILITY ]")
        local npcStatus = addParagraph(panel, "Status", "Click button to check Gyro spawn")
        
        -- Safe on-demand check button instead of hazardous background loop
        addButton(panel, "Check & TP to Gyro", "Find Gyro", function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            
            local found = false
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj.Name:lower():find("gyro") then
                    local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                    if targetPart then
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        found = true
                        npcStatus.Text = "<b>Status:</b> \n<font color='#44ff44'>Found & Teleported to Gyro!</font>"
                        break
                    end
                end
            end
            if not found then
                npcStatus.Text = "<b>Status:</b> \n<font color='#ff4444'>Gyro is not spawned right now.</font>"
            end
        end)

        addButton(panel, "Teleport to Nearest NPC", "Go To", function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj ~= char then
                        local targetHRP = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj.PrimaryPart
                        if targetHRP then
                            hrp.CFrame = targetHRP.CFrame + Vector3.new(0, 3, 0)
                            break
                        end
                    end
                end
            end
        end)
    elseif name == "Farm" then
        addSection(panel, "[ AUTO FARM ]")
        addToggle(panel, "Auto Farm Chests", false, function(v) end)
        addToggle(panel, "Auto Farm Herbs", false, function(v) end)
        addButton(panel, "Collect All Nearby", "Collect", function() end)
    elseif name == "Combat" then
        addSection(panel, "[ COMBAT & AIM ]")
        addToggle(panel, "Aimbot Camera Lock", CombatSettings.Aimbot, function(state)
            CombatSettings.Aimbot = state
        end)
        addToggle(panel, "Show FOV Circle", CombatSettings.ShowFOV, function(state)
            CombatSettings.ShowFOV = state
            FOVCircle.Visible = state
        end)
    elseif name == "Saint" then
        addSection(panel, "[ SAINT'S CORPSE ]")
        addToggle(panel, "Watch For Spawns", false, function(v) end)
        addToggle(panel, "Auto Grab Corpse", true, function(v) end)
    elseif name == "Visual" then
        addSection(panel, "[ ESP TOGGLES ]")
        addToggle(panel, "Chest ESP", false, function(v) end)
        addToggle(panel, "Herb ESP", false, function(v) end)
        addToggle(panel, "Player ESP", false, function(v) end)
    elseif name == "Bounty" then
        addSection(panel, "[ VERIFIED SYSTEM INFO ]")
        addButton(panel, "Test Virtual Input", "Fire", function()
            if InputHandlerClient and InputHandlerClient.FireVirtualInput then
                pcall(function() InputHandlerClient:FireVirtualInput("PrimaryInput") end)
            end
        end)
    end

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    TabBtn.BackgroundTransparency = (name == "Fish") and 0 or 1
    TabBtn.Text = "  " .. name
    TabBtn.TextColor3 = (name == "Fish") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 175)
    TabBtn.TextSize = 12
    TabBtn.Font = Enum.Font.SourceSansSemibold
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.Parent = Sidebar
    tabButtons[name] = TabBtn

    TabBtn.MouseButton1Click:Connect(function()
        for tName, p in pairs(tabFrames) do
            p.Visible = (tName == name)
        end
        for tName, b in pairs(tabButtons) do
            if tName == name then
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
                b.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                TweenService:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
                b.TextColor3 = Color3.fromRGB(150, 150, 175)
            end
        end
    end)
end
