    kc.CornerRadius = UDim.new(1, 0)
    kc.Parent = knob

    local state = defaultState
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        local targetColor = state and Color3.fromRGB(210, 40, 40) or Color3.fromRGB(40, 40, 50)
        local targetPos = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        TweenService:Create(toggleBtn, TweenInfo.new(0.15), {BackgroundColor3 = targetColor}):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {Position = targetPos}):Play()
        if callback then callback(state) end
    end)
