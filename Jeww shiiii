-- Safe Notification Helper
local function sendNotification(title, content)
    pcall(function()
        if Luna and Luna.Notify then
            Luna:Notify({ Title = title, Content = content, Duration = 3 })
        else
            game:GetService("StarterGui"):SetCore("SendNotification", { Title = title, Text = content, Duration = 3 })
        end
    end)
end

